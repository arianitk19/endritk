---
import { useTranslations } from "../i18n/utils";
import { type Lang } from "../i18n/ui";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="hero hero--light" aria-label="Intro">
  <div class="hero__art" aria-hidden="true">
    <svg class="hero__art-svg" viewBox="0 0 1120 860" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
      <defs>
        <pattern id="ekgrid" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M56 0H0V56" stroke="var(--ink)" stroke-opacity="0.05" stroke-width="1"></path>
        </pattern>
      </defs>
      <rect x="360" y="40" width="760" height="780" fill="url(#ekgrid)"></rect>
      <g stroke="var(--ink)" stroke-opacity="0.55" stroke-width="1.4">
        <rect x="452" y="120" width="230" height="180"></rect>
        <path d="M452 214 H584"></path>
        <path d="M584 120 V300"></path>
        <path d="M528 300 V262" stroke-opacity="0.5"></path>
        <path d="M528 262 A38 38 0 0 1 490 300" stroke-opacity="0.5"></path>
      </g>
      <g stroke="var(--ink)" stroke-opacity="0.6" stroke-width="1.5">
        <path d="M470 648 H1000"></path>
        <path d="M574 648 V438 H894 V648"></path>
        <path d="M548 438 L734 306 L920 438 Z"></path>
        <path d="M838 356 V386 H862 V372"></path>
        <rect x="612" y="486" width="58" height="74"></rect>
        <path d="M641 486 V560 M612 523 H670" stroke-opacity="0.4"></path>
        <rect x="704" y="486" width="58" height="74"></rect>
        <path d="M733 486 V560 M704 523 H762" stroke-opacity="0.4"></path>
      </g>
      <g stroke="var(--accent)" stroke-opacity="0.85" stroke-width="1.6">
        <rect x="800" y="540" width="56" height="108"></rect>
        <path d="M828 540 V648" stroke-opacity="0.4"></path>
      </g>
      <g stroke="var(--ink)" stroke-opacity="0.4" stroke-width="1">
        <path d="M574 726 H894"></path>
        <path d="M574 718 V734 M894 718 V734 M734 720 V732"></path>
        <path d="M534 438 V648"></path>
        <path d="M526 438 H542 M526 648 H542"></path>
      </g>
      <g stroke="var(--ink)" stroke-opacity="0.45" stroke-width="1.3">
        <path d="M470 470 H560 V560 H470 Z"></path>
        <path d="M506 442 H596 V532"></path>
        <path d="M470 470 L506 442 M560 470 L596 442 M560 560 L596 532"></path>
      </g>
      <g stroke="var(--ink)" stroke-opacity="0.35" stroke-width="1.1">
        <circle cx="1012" cy="150" r="34"></circle>
        <path d="M1012 108 V192 M970 150 H1054" stroke-opacity="0.28"></path>
      </g>
      <circle cx="1012" cy="150" r="4" fill="var(--accent)" fill-opacity="0.9"></circle>
    </svg>
  </div>
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="hero__inner">
    <div>
      <p class="hero__name">{t("hero.name")}</p>
      <h1 class="hero__title">
        <span class="line"><span>{t("hero.t1")}</span></span>
        <span class="line"><span>{t("hero.t2")}</span></span>
        <span class="line"><span class="accent">{t("hero.t3")}</span></span>
      </h1>
    </div>
    <div class="hero__aside">
      <p class="hero__lead">{t("hero.lead")}</p>
      <div class="hero__cta">
        <a href="#kontakt" class="btn btn--solid">
          <span>{t("hero.cta")}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="#projekte" class="link-arrow">
          <span>{t("hero.cta2")}</span>
          <span class="arrow" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>

  <a href="#intro" class="hero__scroll" aria-label={t("hero.scroll")}>
    <span class="line-v" aria-hidden="true"></span>
  </a>
</section>
