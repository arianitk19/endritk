---
import "../styles/global.css";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offline — Endrit Krasniqi</title>
    <meta name="theme-color" content="#F4F1EA" />
    <meta name="robots" content="noindex" />
    <style>
      body { display: grid; place-items: center; min-height: 100svh; text-align: center; padding: 24px; }
      .off { max-width: 42ch; }
      .off h1 { font-size: clamp(28px, 6vw, 48px); font-weight: 600; letter-spacing: -0.02em; color: var(--charcoal); }
      .off p { color: var(--muted); margin-top: 16px; line-height: 1.7; }
      .off a { display: inline-flex; margin-top: 28px; border: 1px solid var(--charcoal); padding: 14px 22px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
      .off .mark { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted); margin-bottom: 28px; }
    </style>
  </head>
  <body>
    <div class="off">
      <div class="mark">Endrit Krasniqi</div>
      <h1>Keine Verbindung</h1>
      <p>Diese Seite ist derzeit offline nicht verfügbar. Bitte prüfen Sie Ihre Internetverbindung und versuchen Sie es erneut.</p>
      <a href="/">Zur Startseite</a>
    </div>
  </body>
</html>
