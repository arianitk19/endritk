---
import "../styles/global.css";
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Endrit Krasniqi</title>
    <meta name="theme-color" content="#F4F1EA" />
    <meta name="robots" content="noindex" />
    <style>
      body { display: grid; place-items: center; min-height: 100svh; text-align: center; padding: 24px; }
      .nf { max-width: 44ch; }
      .nf .code { font-family: var(--font-serif); font-style: italic; font-size: clamp(56px, 16vw, 128px); color: var(--accent); line-height: 1; }
      .nf h1 { font-size: clamp(22px, 4vw, 32px); font-weight: 600; letter-spacing: -0.02em; color: var(--charcoal); margin-top: 8px; }
      .nf p { color: var(--muted); margin-top: 16px; line-height: 1.7; }
      .nf a { display: inline-flex; margin-top: 28px; border: 1px solid var(--charcoal); padding: 14px 22px; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; }
    </style>
  </head>
  <body>
    <div class="nf">
      <div class="code">404</div>
      <h1>Seite nicht gefunden</h1>
      <p>Die angeforderte Seite existiert nicht oder wurde verschoben.</p>
      <a href="/">Zur Startseite</a>
    </div>
  </body>
</html>
